---
import "../styles/global.css";
import Preloader from "../components/react/preloader";
import { Stage } from "../components/react/stage";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/apple.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Naman Sonawane</title>
    <meta
      name="description"
      content="Naman Sonawane, software developer based in Toronto building AI-driven products. AI/NLP at Cohere, ML/AI research at MIT CSAIL."
    />
  </head>

  <body class="main-body antialiased">
    <div id="ns-ssr-overlay" class="ns-ssr-overlay"></div>
    <Preloader client:load />

    <div class="mx-auto w-full max-w-[1400px] px-6 sm:px-10">
      <main>
        <Stage client:load />
      </main>
    </div>

    <script>
      // Drop the no-flash splash once the preloader has taken over.
      (function () {
        const hide = () => {
          const el = document.getElementById("ns-ssr-overlay");
          if (el) el.classList.add("hide");
        };
        window.addEventListener("ns-overlay-mounted", hide, { once: true });
        window.addEventListener("ns-overlay-uncovered", hide, { once: true });
        window.addEventListener("load", () => setTimeout(hide, 500));
      })();
    </script>
  </body>
</html>
