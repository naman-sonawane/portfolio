---
import "../styles/global.css";
import { Navbar } from "../components/react/navbar";
import { Tagline } from "../components/react/tagline";
import { About } from "../components/react/about";
import { Contact } from "../components/react/contact";
import { MusicPlayer } from "../components/react/music-player";
import { Projects } from "../components/react/projects";
import { Photo } from "../components/react/photo";
import NavHeart from "../components/react/heart";
import TransitionOverlay from "../components/react/transition-overlay";
import SnowfallEffect from "../components/react/snowfall";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/personal.jpg" imagesrcset="/personal.jpg 1x" imagesizes="100vw" fetchpriority="high">
    <link rel="preload" as="image" href="/work.svg">
    <link rel="preload" as="image" href="/top-right.svg">
    <meta name="generator" content={Astro.generator} />
    <title>Naman Sonawane</title>
  </head>

  <body class="bg-[#3a4664] p-4 main-body h-screen flex flex-col gap-y-4">
    <SnowfallEffect client:load />
    <div id="ns-ssr-overlay" class="ns-ssr-overlay">NS</div>
    <TransitionOverlay client:load />
    <Navbar client:load />

    <div id="desktop-layout" class="grid grid-cols-10 gap-4 h-[calc(100vh-70px-32px-4px)]">
      <div class="col-span-7 w-full h-full">
        <div class="flex flex-col gap-y-4 h-full w-full">
          <div class="grid grid-cols-8 h-[60%] gap-4">
            <Tagline client:load />

            <Photo client:load />
          </div>

          <div class="grid grid-cols-2 h-[40%] gap-4">
            <About client:load />
            <Contact client:load />
          </div>
        </div>
      </div>

      <div class="col-span-3 flex flex-col gap-y-4">
        <Projects client:load />
        <MusicPlayer client:load />
      </div>
    </div>

    
    <div id="mobile-layout" class="hidden">
      <div class="flex flex-col gap-3 h-[calc(100vh-70px-32px-4px)] overflow-y-auto">
        
        <div class="grid grid-cols-2 gap-2 flex-shrink-0">
          <Tagline client:load />
          <Photo client:load className="rounded-xl overflow-hidden w-full h-full" />
        </div>
        
        
        <div class="flex-shrink-0">
          <About client:load />
        </div>
        
        
        <div class="flex-shrink-0">
          <MusicPlayer client:load />
        </div>
        
        
        <div class="grid grid-cols-2 gap-2 flex-shrink-0">
          <div class="bg-[#ffe1c6] contact-container text-[#3a4664] rounded-xl p-4 flex flex-col cursor-pointer hover:bg-[#ffe9db] transition-colors" onclick="window.location.href='/work'">
            <a
      href="/work"
      class=" relative"
    >
      <img
        src="/top-right.svg"
        alt="top-right"
        class="absolute right-2 contact-arrow"
        height={20}
        width={20}
      />

      <div class="contact-text instrument text-xl ">
        My <span class="italic">Work</span>
      </div>
    </a>
          </div>
          <div class="bg-[#161711] rounded-xl p-4 flex items-center justify-center">
            <NavHeart client:load />
          </div>
        </div>
        
        
        <div class="flex-shrink-0 h-80">
          <Projects client:load />
        </div>
      </div>
    </div>

    <script>
      
      (function() {
        /** @param {HTMLAnchorElement} a */
        function isInternalLink(a: HTMLAnchorElement) {
          return a.host === window.location.host && !a.target && !a.href.startsWith('mailto:') && !a.href.startsWith('tel:');
        }
        document.addEventListener('click', function(e) {
          const path = (e.composedPath ? e.composedPath() : []) as any[];
          let anchor: HTMLAnchorElement | null = null;
          for (const el of path) {
            const node = el as HTMLElement;
            if (node && (node as HTMLElement).tagName === 'A') { anchor = node as HTMLAnchorElement; break; }
          }
          if (!anchor) {
            
            const t = e.target as Element | null;
            if (t && (t as Element).closest) anchor = (t as Element).closest('a') as HTMLAnchorElement | null;
          }
          if (!anchor) return;
          if (!isInternalLink(anchor)) return;
          const href = anchor.getAttribute('href');
          if (!href || href.startsWith('#')) return;
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('page-transition', { detail: { href } }));
        }, true);
      })();

      
      function handleMobileLayout() {
        const isMobile = window.innerWidth < 768;
        const body = document.body;
        const desktop = document.getElementById('desktop-layout');
        const mobile = document.getElementById('mobile-layout');

        if (isMobile) {
          body.className = 'bg-[#3a4664] p-3 main-body h-screen flex flex-col gap-y-4';
          if (desktop) desktop.classList.add('hidden');
          if (mobile) mobile.classList.remove('hidden');
        } else {
          body.className = 'bg-[#3a4664] p-4 main-body h-screen flex flex-col gap-y-4';
          if (desktop) desktop.classList.remove('hidden');
          if (mobile) mobile.classList.add('hidden');
        }
      }

      
      handleMobileLayout();
      window.addEventListener('resize', handleMobileLayout);
      
      (function() {
        const hide = () => {
          const el = document.getElementById('ns-ssr-overlay');
          if (!el) return;
          el.classList.add('hide');
          setTimeout(() => el.parentElement && el.parentElement.removeChild(el), 800);
        };
        window.addEventListener('ns-overlay-mounted', hide, { once: true });
        window.addEventListener('ns-overlay-uncovered', hide, { once: true });
        window.addEventListener('load', () => setTimeout(hide, 700));
      })();
    </script>
  </body>
</html>
